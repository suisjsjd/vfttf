# Safe, non-secret runtime settings for Staxa.
# Import these in Staxa Step 4 (Environment), or enter them manually.
PORT=20128
HOSTNAME=0.0.0.0
DATA_DIR=/app/data
NODE_ENV=production
AUTH_COOKIE_SECURE=true
BASE_URL=https://sc-xzc.staxa.app

# Add the following as Staxa Secret variables with your own strong random values:
# INITIAL_PASSWORD=<your-long-unique-login-password>
# JWT_SECRET=<random-secret-at-least-32-bytes>
# API_KEY_SECRET=<different-random-secret>
# MACHINE_ID_SALT=<another-different-random-secret>
